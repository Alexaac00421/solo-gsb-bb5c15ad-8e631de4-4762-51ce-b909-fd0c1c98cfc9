# Bus transfer fare clearing service

APP_NAME=bus-fare-clearing

# PostgreSQL connection (used by docker compose)
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=fare
POSTGRES_USER=fare
POSTGRES_PASSWORD=farepass

# Business rules (override if needed)
DAILY_CAP_CENTS=2000
TRANSFER_GAP_MINUTES=90

# Seconds to wait for the database on startup
DB_CONNECT_RETRIES=60
